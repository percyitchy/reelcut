# Copy this file to .env.local and fill in the values

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis: stores the email list, feedback and rate limits
# (locally: docker compose up -d redis serverless-redis-http)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

# Email gate: sign the access cookie and protect the CSV export
ACCESS_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-too

# Optional: where "Open the editor" points (defaults to /projects)
# EDITOR_URL=/projects

# Optional: sound effect search
# FREESOUND_CLIENT_ID=
# FREESOUND_API_KEY=
