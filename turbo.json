{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**"
			],
			"env": [
				"NODE_ENV",
				"NEXT_PUBLIC_SITE_URL",
				"UPSTASH_REDIS_REST_URL",
				"UPSTASH_REDIS_REST_TOKEN",
				"ACCESS_SECRET",
				"ADMIN_KEY",
				"EDITOR_URL",
				"FREESOUND_CLIENT_ID",
				"FREESOUND_API_KEY"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"preview": {
			"persistent": true,
			"cache": false
		},
		"deploy": {
			"cache": false
		},
		"lint": {
			"dependsOn": [
				"^lint"
			],
			"cache": false
		},
		"lint:fix": {
			"dependsOn": [
				"^lint:fix"
			],
			"cache": false
		},
		"format": {
			"dependsOn": [
				"^format"
			]
		}
	}
}
